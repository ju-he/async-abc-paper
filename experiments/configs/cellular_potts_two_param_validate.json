{
  "_comment": [
    "One-method validation of the two-parameter CPM setup before the full",
    "3-method x 5-replicate run (.plans/HANDOFF_cpm_experiment_2026-09-19.md, job 2).",
    "Identical benchmark and inference blocks to cellular_potts_two_param.json --",
    "only the method list and the replicate count differ, so what it measures is",
    "the setup, not a different experiment.",
    "The number to check is posterior contraction against the prior: the forecast",
    "is 91% on division_rate and 64% on cell_volume at 2% acceptance, with the",
    "posterior essentially uncorrelated (+0.04). Three replicates give the",
    "between-run spread on that.",
    "Cost: 3 x 2000 evaluations x 4 replicate seeds = 24,000 simulations."
  ],
  "experiment_name": "cellular_potts_two_param_validate",
  "benchmark": {
    "name": "cellular_potts",
    "nastja_config_template": "experiments/assets/cellular_potts/sim_config.json",
    "config_builder_params": "experiments/assets/cellular_potts/config_builder_params.json",
    "distance_metric_params": "experiments/assets/cellular_potts/distance_metric_params_size.json",
    "parameter_space": "experiments/assets/cellular_potts/parameter_space_division_volume.json",
    "reference_data_path": "experiments/data/cpm_reference_proposed",
    "output_dir": "experiments/data/cpm_sims",
    "engine_backend": "cis",
    "seed_param_name": "random_seed",
    "seed_param_path": "Settings.randomseed",
    "true_division_rate": 0.009,
    "true_params_scale": "physical",
    "true_cell_volume": 500,
    "n_replicates_per_evaluation": 4,
    "average_reference_replicates": true
  },
  "methods": [
    "async_propulate_abc"
  ],
  "inference": {
    "max_simulations": 2000,
    "n_workers": 48,
    "k": 100,
    "tol_init": 10.0,
    "n_generations": 1000,
    "max_wall_time_s": 3600,
    "scheduler_type": "acceptance_rate",
    "perturbation_scale": 0.8,
    "propulate_budget_mode": "total_simulations",
    "kernel": "gaussian",
    "amis_snapshots": 20
  },
  "execution": {
    "n_replicates": 3,
    "base_seed": 0
  },
  "plots": {
    "posterior": true,
    "archive_evolution": true,
    "corner": true,
    "tolerance_trajectory": true,
    "quality_vs_time": true
  },
  "analysis": {
    "target_wasserstein": 2.0
  },
  "paper": {
    "experiment_role": "validity",
    "method_comparison_roles": {
      "async_propulate_abc": "proposed_async_method",
      "pyabc_smc": "external_framework_reference",
      "rejection_abc": "small_model_reference",
      "abc_smc_baseline": "main_sync_baseline"
    }
  }
}
